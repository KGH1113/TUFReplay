{
  "name": "tuf-replay",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "web",
    "tools/auto-submission-e2e"
  ],
  "scripts": {
    "e2e:live:prepare": "bun tools/live-e2e/prepare.ts",
    "e2e:live": "bun tools/live-e2e/start.ts",
    "e2e:live:settings": "bun tools/live-e2e/settings.ts",
    "e2e:live:verify-auth": "bun tools/live-e2e/verify-auth.ts",
    "e2e:prepare": "bun run --cwd tools/auto-submission-e2e prepare:fixtures",
    "e2e:reset": "bun run tools/auto-submission-e2e/src/reset.ts",
    "e2e:inspect": "bun run tools/auto-submission-e2e/src/test-lifecycle.ts",
    "e2e:dev": "bun run --cwd tools/auto-submission-e2e dev",
    "e2e:test": "bun run --cwd tools/auto-submission-e2e test:e2e",
    "web:dev": "bun run --cwd web dev",
    "web:test": "bun run --cwd web test",
    "web:typecheck": "bun run --cwd web typecheck",
    "web:format": "bun run --cwd web format",
    "web:format:check": "bun run --cwd web format:check",
    "web:biome": "bun run --cwd web biome:check",
    "web:build": "bun run --cwd web build",
    "web:preview": "bun run --cwd web preview"
  }
}

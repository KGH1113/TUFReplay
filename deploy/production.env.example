# Copy this file to /srv/TUFReplay/.env.production and set the blank values
# through a password manager. Keep the real file out of Git and chmod it 600.
# Generate distinct, URL-safe secrets for the database password and both tokens.
TUF_REPLAY_DB_USER=tuf_replay_prod
TUF_REPLAY_DB_PASSWORD=
TUF_TO_AUTO_SUBMISSION_TOKEN=
AUTO_SUBMISSION_TO_TUF_TOKEN=
SUBMISSION_VALIDATION_MODE=trusted_tester

# Optional web build override. The production default is the same value.
VITE_WEB_ADOFAI_EMBED_URL=https://web-adofai.impl1113.dev/embed/chart

TUF_REPLAY_DB_USER=tuf_replay
TUF_REPLAY_DB_PASSWORD=
TUF_TO_AUTO_SUBMISSION_TOKEN=
AUTO_SUBMISSION_TO_TUF_TOKEN=
SUBMISSION_VALIDATION_MODE=trusted_tester

# Set r2 only after placing the four S3 credentials in the protected r2.env file.
TUF_REPLAY_STORAGE=local
R2_LOCAL_FALLBACK=true

# Optional tester-admin profile. Use distinct randomly generated secrets.
# Database password must be URL-safe; 32 random bytes encoded as hex is suitable.
TRUSTED_TESTERS_DB_PASSWORD=
TRUSTED_TESTERS_ADMIN_USERNAME=operator
TRUSTED_TESTERS_ADMIN_PASSWORD=
